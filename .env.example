# All keys are optional. Without them Atlas runs on free, keyless data.

# Google Maps Platform key with the "Map Tiles API" enabled.
# Unlocks Google's Photorealistic 3D Tiles (Google Earth-style 3D cities and terrain).
VITE_GOOGLE_MAPS_API_KEY=

# Cesium ion access token (https://ion.cesium.com/tokens).
# Unlocks Cesium World Terrain (lit, high-resolution terrain mesh).
VITE_CESIUM_ION_TOKEN=

# The shared story library: a Supabase project's URL and its public "anon" key
# (see docs/stories-backend.md). Without them, stories are shared by link.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Events near a place ("People › Events"); see docs/events.md. Any one is enough.
# Ticketmaster Discovery API consumer key (developer.ticketmaster.com)
VITE_TICKETMASTER_KEY=
# SeatGeek client id (seatgeek.com/account/develop)
VITE_SEATGEEK_CLIENT_ID=
# Eventbrite private token and organization id: lists that organization's own events
VITE_EVENTBRITE_TOKEN=
VITE_EVENTBRITE_ORG_ID=

# Atlas's edge (proxy/atlas-edge-worker.js; docs/backend.md): caches public services, holds keys.
VITE_ATLAS_EDGE=
# The keyed services the edge holds keys for, e.g. ticketmaster,eventbrite,aisstream (live ships worldwide)
VITE_ATLAS_EDGE_KEYS=

# Feedback: a form endpoint (e.g. Formspree) that accepts JSON posts; and/or an email for "Email instead".
VITE_FEEDBACK_URL=
VITE_FEEDBACK_EMAIL=
