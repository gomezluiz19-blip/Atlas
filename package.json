    "@tensorflow/tfjs-core": "^4.22.0",
    "@types/three": "^0.186.0",
    "cesium": "^1.145.0",
    "lucide": "^1.48.0",
    "satellite.js": "^6.0.2",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
