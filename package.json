{
  "name": "atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An intuitive, deep 3D Earth workspace for earth-science students.",
  "scripts": {
    "postinstall": "node scripts/copy-cesium.mjs",
    "dev": "vite",
